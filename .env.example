APP_NAME=Dispatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8012

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dispatch_dev
DB_USERNAME=dispatch_dev
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
HORIZON_MAX_PROCESSES=4
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_SCHEME=smtp
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=development@example.test
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


DISPATCH_DELIVERY_PROVIDER=simulation
SENDGRID_ENABLED=false
SENDGRID_LIVE_SENDING_ENABLED=false
SENDGRID_REQUESTS_PER_MINUTE=60
DISPATCH_WEBHOOK_RETENTION_DAYS=14
DISPATCH_ENGAGEMENT_RETENTION_DAYS=90

# Set only explicit trusted proxy IP/CIDR values for a reviewed deployment.
DISPATCH_TRUSTED_PROXIES=


# Restricted campaign pilot. Does not enable SendGrid or live sending.
DISPATCH_PILOT_ENABLED=true
DISPATCH_PILOT_DAILY_LIMIT=25
DISPATCH_PILOT_RECIPIENT_ALLOWLIST_ENABLED=true
DISPATCH_PILOT_RECIPIENTS=
DISPATCH_PILOT_ORGANISATION_IDS=
